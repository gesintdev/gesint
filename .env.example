# Copie para .env na raiz:  copy .env.example .env
# O Docker Compose le automaticamente o .env da raiz para substituir ${POSTGRES_PASSWORD}.

POSTGRES_DB=gesint
POSTGRES_USER=gesint
POSTGRES_PASSWORD=gesint_dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesint
DB_USER=gesint
DB_PASSWORD=gesint_dev

JWT_SECRET=
# DEV: sudo admGesint / flavio.henrique.dev@gmail.com — editar so no Admin > Ambiente de desenvolvimento.
# Em producao deixe em branco e defina senha forte no painel/VPS.
GESINT_PLATFORM_ADMIN_PASSWORD=AdmGesint@#26
DEV_ADMIN_PASSWORD=AdmGesint@#26
NEXTAUTH_SECRET=
# DEV: login de negocio no schema public (dev-public). Em prod fica false via application-prod.yml.
GESINT_PUBLIC_LOGIN_ENABLED=true
GESINT_DEV_ENVIRONMENT_UI=true

# gesint-backend (Client)
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000,http://localhost:3001,http://localhost:8090
SERVER_PORT=8081
GESINT_STORAGE_MAX_FILE_SIZE=25MB
GESINT_STORAGE_MAX_REQUEST_SIZE=30MB
# OCR holerites (dev local): baixe com scripts/download-tesseract-por.ps1 ou defina caminho do tessdata
# TESSDATA_PREFIX=../data/tessdata

# gesint-admin-backend (Admin)
ADMIN_SERVER_PORT=8082
ADMIN_CORS_ORIGINS=http://localhost:3001
TENANT_DB_FALLBACK_PASSWORD=gesint_dev

# Multi-tenant (Client — ver docs/arquitetura/multi-tenant-dev.md)
GESINT_MULTI_TENANT_ENABLED=true
GESINT_TENANT_HEADER_ENABLED=true
GESINT_TENANT_BASE_DOMAIN=localhost

# Eventos internos Admin → Client (outbox de sistemas contratados)
# Nome histórico da env: GESINT_HR_BASE_URL = URL do Client backend
GESINT_HR_BASE_URL=http://localhost:8081
GESINT_INTERNAL_EVENT_SECRET=altere-este-segredo-compartilhado

# Assistente IA / LLM (Client backend)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
# Soft budget shown in the assistant footer (dev only). Google does not expose remaining quota via API key —
# copy the TPM/daily figure from AI Studio > Rate limits if you want a progress bar.
# LLM_DAILY_TOKEN_LIMIT=250000

# gesint-frontend (Client): variaveis NEXT_PUBLIC_* ficam em gesint-frontend/.env.local
# NEXT_PUBLIC_MULTI_TENANT_ENABLED=true
