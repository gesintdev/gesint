# Copie para .env na raiz:  copy .env.example .env
# O Docker Compose le automaticamente o .env da raiz para substituir ${POSTGRES_PASSWORD}.

POSTGRES_DB=gommo
POSTGRES_USER=gommo
POSTGRES_PASSWORD=gommo_dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gommo
DB_USER=gommo
DB_PASSWORD=gommo_dev

JWT_SECRET=altere-para-minimo-32-caracteres-aleatorios
# Senha do sudo da plataforma (admGommo / gommo.admin@gmail.com). Preferencial: GOMMO_PLATFORM_ADMIN_PASSWORD.
GOMMO_PLATFORM_ADMIN_PASSWORD=altere-senha-do-admin-plataforma
DEV_ADMIN_PASSWORD=altere-senha-do-admin-dev
NEXTAUTH_SECRET=altere-para-minimo-32-caracteres-aleatorios

# gommo-backend (Client)
CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000,http://localhost:3001,http://localhost:8090
SERVER_PORT=8081
GOMMO_STORAGE_MAX_FILE_SIZE=25MB
GOMMO_STORAGE_MAX_REQUEST_SIZE=30MB
# OCR holerites (dev local): baixe com scripts/download-tesseract-por.ps1 ou defina caminho do tessdata
# TESSDATA_PREFIX=../data/tessdata

# gommo-admin-backend (Admin)
ADMIN_SERVER_PORT=8082
ADMIN_CORS_ORIGINS=http://localhost:3001
TENANT_DB_FALLBACK_PASSWORD=gommo_dev

# Multi-tenant (Client — ver docs/arquitetura/multi-tenant-dev.md)
GOMMO_MULTI_TENANT_ENABLED=true
GOMMO_TENANT_HEADER_ENABLED=true
GOMMO_TENANT_BASE_DOMAIN=localhost

# Eventos internos Admin → Client (outbox de sistemas contratados)
# Nome histórico da env: GOMMO_HR_BASE_URL = URL do Client backend
GOMMO_HR_BASE_URL=http://localhost:8081
GOMMO_INTERNAL_EVENT_SECRET=altere-este-segredo-compartilhado

# Assistente IA / LLM (Client backend)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
# Soft budget shown in the assistant footer (dev only). Google does not expose remaining quota via API key —
# copy the TPM/daily figure from AI Studio > Rate limits if you want a progress bar.
# LLM_DAILY_TOKEN_LIMIT=250000

# gommo-frontend (Client): variaveis NEXT_PUBLIC_* ficam em gommo-frontend/.env.local
# NEXT_PUBLIC_MULTI_TENANT_ENABLED=true
