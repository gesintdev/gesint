# Copie para .env — nunca commite .env
# Formato alinhado ao Coolify (Application gommo-backend).
# Ver tambem: infra/coolify/env/client-backend.env.example
#
# Nao defina SPRING_PROFILES_ACTIVE neste arquivo (quebra o perfil dev).
# Prod nativo: mvn -q spring-boot:run -Dspring-boot.run.profiles=prod

SERVER_PORT=8081

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gommo
DB_USER=gommo
DB_PASSWORD=gommo_dev

JWT_SECRET=altere-para-minimo-32-caracteres-aleatorios
GOMMO_INTERNAL_EVENT_SECRET=altere-este-segredo-compartilhado

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

STORAGE_LOCAL_PATH=./data/storage
STORAGE_BUCKET=gommo-local
GOMMO_STORAGE_MAX_FILE_SIZE=25MB
GOMMO_STORAGE_MAX_REQUEST_SIZE=30MB

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

GOMMO_MULTI_TENANT_ENABLED=true
GOMMO_TENANT_HEADER_ENABLED=true
GOMMO_TENANT_BASE_DOMAIN=localhost

LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
