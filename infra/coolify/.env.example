# Variaveis para o Coolify (Environment / Shared Variables do projeto).
# Nao commitar valores reais. Gere segredos fortes (openssl rand -base64 32).

# --- PostgreSQL ---
POSTGRES_DB=gommo
POSTGRES_USER=gommo
POSTGRES_PASSWORD=

# --- Segredos ---
JWT_SECRET=
NEXTAUTH_SECRET=
# Mesmo valor nos dois backends (eventos internos Admin -> Client)
GOMMO_INTERNAL_EVENT_SECRET=

# --- Rede Docker interna (Admin backend -> Client backend) ---
# NAO use a URL publica do Coolify. Hostname do servico no compose.
GOMMO_HR_BASE_URL=http://gommo-backend:8081

# --- URLs publicas ---
# Sem dominio proprio: copie a FQDN gerada pelo Coolify em cada servico
# (Settings do servico / Domains), com https e SEM barra final.
# Exemplo tipico: https://gommo-frontend-<uuid>.sslip.io
#
# Com dominio proprio depois: troque pelos seus hosts (app/api/admin/admin-api).

# Client frontend (gommo-frontend)
HR_NEXTAUTH_URL=https://COLE-AQUI-FQDN-DO-GOMMO-FRONTEND
# Client backend publico (gommo-backend) — build-time no frontend
NEXT_PUBLIC_API_URL=https://COLE-AQUI-FQDN-DO-GOMMO-BACKEND
# Origins exatas dos frontends (CSV). Tem que bater com a URL do browser.
CORS_ORIGINS=https://COLE-AQUI-FQDN-DO-GOMMO-FRONTEND,https://COLE-AQUI-FQDN-DO-GOMMO-ADMIN-FRONTEND

# Admin frontend (gommo-admin-frontend)
ADMIN_NEXTAUTH_URL=https://COLE-AQUI-FQDN-DO-GOMMO-ADMIN-FRONTEND
ADMIN_AUTH_URL=https://COLE-AQUI-FQDN-DO-GOMMO-ADMIN-FRONTEND
# Admin backend publico — build-time
NEXT_PUBLIC_ADMIN_API_URL=https://COLE-AQUI-FQDN-DO-GOMMO-ADMIN-BACKEND
# Client backend publico (Admin frontend tambem chama o Client API)
NEXT_PUBLIC_HR_API_URL=https://COLE-AQUI-FQDN-DO-GOMMO-BACKEND
ADMIN_CORS_ORIGINS=https://COLE-AQUI-FQDN-DO-GOMMO-ADMIN-FRONTEND

# --- Storage (Client) ---
STORAGE_BUCKET=gommo-prod
