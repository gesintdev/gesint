# Variaveis para o Coolify no modo Docker Compose unico
# (Environment / Shared Variables do projeto Compose).
# Para apps separados, use os arquivos em env/*.env.example
# Nao commitar valores reais. Gere segredos fortes (openssl rand -base64 32).

# --- PostgreSQL ---
POSTGRES_DB=gesint
POSTGRES_USER=gesint
POSTGRES_PASSWORD=

# --- Segredos ---
JWT_SECRET=
NEXTAUTH_SECRET=
# Mesmo valor nos dois backends (eventos internos Admin -> Client)
GESINT_INTERNAL_EVENT_SECRET=

# --- Rede Docker interna (Admin backend -> Client backend) ---
# NAO use a URL publica do Coolify. Hostname do servico no compose.
GESINT_HR_BASE_URL=http://gesint-backend:8081

# --- URLs publicas ---
# Sem dominio proprio: copie a FQDN gerada pelo Coolify em cada servico
# (Settings do servico / Domains), com https e SEM barra final.
# Exemplo tipico: https://gesint-frontend-<uuid>.sslip.io
#
# Com dominio proprio depois: troque pelos seus hosts (app/api/admin/admin-api).

# Dominios de producao Gesint (apos DNS na Cloudflare):
#   app.gesint.com.br / *.gesint.com.br | admin.gesint.com.br
#   api.gesint.com.br | admin-api.gesint.com.br
# Apex gesint.com.br fica fora do ERP (marketing depois).

# Client frontend (gesint-frontend)
HR_NEXTAUTH_URL=https://app.gesint.com.br
# Client backend publico (gesint-backend) — build-time no frontend
NEXT_PUBLIC_API_URL=https://api.gesint.com.br
# Origins exatas dos frontends (CSV). Tem que bater com a URL do browser.
CORS_ORIGINS=https://app.gesint.com.br,https://admin.gesint.com.br

# Admin frontend (gesint-admin-frontend)
ADMIN_NEXTAUTH_URL=https://admin.gesint.com.br
ADMIN_AUTH_URL=https://admin.gesint.com.br
# Admin backend publico — build-time
NEXT_PUBLIC_ADMIN_API_URL=https://admin-api.gesint.com.br
# Client backend publico (Admin frontend tambem chama o Client API)
NEXT_PUBLIC_HR_API_URL=https://api.gesint.com.br
ADMIN_CORS_ORIGINS=https://admin.gesint.com.br

# Multi-tenant
GESINT_TENANT_PRODUCTION_BASE_DOMAIN=gesint.com.br
NEXT_PUBLIC_TENANT_PRODUCTION_BASE_DOMAIN=gesint.com.br
GESINT_PLATFORM_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
LLM_API_KEY=
GESINT_SECRET_ENCRYPTION_KEY=

# --- Storage (Client) ---
STORAGE_BUCKET=gesint-prod
