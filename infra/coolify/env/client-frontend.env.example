# Runtime (Coolify Environment)
PORT=3000
HOSTNAME=0.0.0.0
# OBRIGATÓRIO: mesmo host do browser (não use sslip.io gerado pelo Coolify)
NEXTAUTH_URL=https://COLE-FQDN-GOMMO-FRONTEND
AUTH_URL=https://COLE-FQDN-GOMMO-FRONTEND
NEXTAUTH_SECRET=
AUTH_SECRET=

# Lab com cert self-signed (*.local): necessário para Auth.js chamar a API no server
NODE_TLS_REJECT_UNAUTHORIZED=0
# Runtime: URL HTTP interna do gommo-backend (UUID Coolify):8081 — evita Traefik/DNS *.local
API_INTERNAL_URL=http://COLE-UUID-GOMMO-BACKEND:8081

# Build-time (Coolify Build Arguments) — exige rebuild ao mudar
NEXT_PUBLIC_API_URL=https://COLE-FQDN-GOMMO-BACKEND
NEXT_PUBLIC_MULTI_TENANT_ENABLED=true
# Domínio base do Client (slug.dominio). Lab: gommo.local | Prod: gommo.com.br
NEXT_PUBLIC_TENANT_PRODUCTION_BASE_DOMAIN=COLE-DOMINIO-BASE

# Portal do candidato — Google Identity Services (mesmo Client ID do backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Copia local pronta: gommo-frontend/.env (localhost)
# Lab LAN (template): infra/coolify/env/lab-gommo.local.env.example
