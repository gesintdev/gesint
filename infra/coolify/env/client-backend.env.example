# --- PostgreSQL (Coolify Database) — use o host INTERNO do recurso ---
# Local nativo: localhost | Compose local: postgres (sobrescrito no compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gommo
DB_USER=gommo
DB_PASSWORD=

SERVER_PORT=8081

JWT_SECRET=
GOMMO_INTERNAL_EVENT_SECRET=

# Origins exatas dos frontends (CSV), https, sem barra final
CORS_ORIGINS=https://COLE-FQDN-GOMMO-FRONTEND,https://COLE-FQDN-GOMMO-ADMIN-FRONTEND

STORAGE_LOCAL_PATH=/data/storage
STORAGE_BUCKET=gommo-prod

# Respeita o limite de memoria do container (sugestao KVM 2: 1792M)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Copia local pronta: gommo-backend/.env (e .env.example)
