# --- PostgreSQL (Coolify Database) — use o host INTERNO do recurso ---
# Local nativo: localhost | Compose local: postgres (sobrescrito no compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesint
DB_USER=gesint
DB_PASSWORD=

SERVER_PORT=8081

JWT_SECRET=
GESINT_INTERNAL_EVENT_SECRET=

# Origins exatas dos frontends (CSV), https, sem barra final
CORS_ORIGINS=https://COLE-FQDN-GESINT-FRONTEND,https://COLE-FQDN-GESINT-ADMIN-FRONTEND

STORAGE_LOCAL_PATH=/data/storage
STORAGE_BUCKET=gesint-prod

# Multi-tenant (lab/prod). Base domain = sufixo dos hosts dos clientes
GESINT_MULTI_TENANT_ENABLED=true
GESINT_TENANT_HEADER_ENABLED=true
GESINT_TENANT_PRODUCTION_BASE_DOMAIN=COLE-DOMINIO-BASE
# Ex. lab: gesint.local | prod: gesint.com.br
GESINT_PLATFORM_ADMIN_PASSWORD=

# Respeita o limite de memoria do container (sugestao KVM 2: 1792M)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Portal do candidato — Google OAuth (mesmo Client ID do frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Copia local pronta: gesint-backend/.env (e .env.example)
# Lab LAN (template): infra/coolify/env/lab-gesint.local.env.example

