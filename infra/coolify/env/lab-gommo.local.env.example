# =============================================================================
# Lab LAN (Coolify + acesso remoto) — TEMPLATE (sem segredos)
# Domínios exemplo: admin.gommo.local / api.admin.gommo.local / gommo.local / api.gommo.local
# Copie para lab-gommo.local.env (gitignored) e preencha os valores reais.
# =============================================================================

# --- gommo-admin-frontend (Production) ---
AUTH_URL=https://admin.gommo.local
NEXTAUTH_URL=https://admin.gommo.local
NEXT_PUBLIC_ADMIN_API_URL=https://api.admin.gommo.local
NEXT_PUBLIC_HR_API_URL=https://api.gommo.local
# Lab only: TLS self-signed no fetch server-side do Auth.js
NODE_TLS_REJECT_UNAUTHORIZED=0
# Opcional: URL HTTP interna do admin-backend (UUID Coolify):8082
# ADMIN_API_INTERNAL_URL=http://<COOLIFY_ADMIN_BACKEND_UUID>:8082
PORT=3001
HOSTNAME=0.0.0.0
NEXTAUTH_SECRET=
AUTH_SECRET=

# --- gommo-admin-backend ---
ADMIN_SERVER_PORT=8082
ADMIN_CORS_ORIGINS=https://admin.gommo.local
GOMMO_PLATFORM_ADMIN_PASSWORD=
JWT_SECRET=
GOMMO_INTERNAL_EVENT_SECRET=
# URL INTERNA do gommo-backend (UUID do app no Coolify), NÃO a FQDN pública
GOMMO_HR_BASE_URL=http://<COOLIFY_CLIENT_BACKEND_UUID>:8081

# --- gommo-frontend (Production) ---
AUTH_URL=https://gommo.local
NEXTAUTH_URL=https://gommo.local
NEXT_PUBLIC_API_URL=https://api.gommo.local
NEXT_PUBLIC_MULTI_TENANT_ENABLED=true
NEXT_PUBLIC_TENANT_PRODUCTION_BASE_DOMAIN=gommo.local
API_INTERNAL_URL=http://<COOLIFY_CLIENT_BACKEND_UUID>:8081
NODE_TLS_REJECT_UNAUTHORIZED=0
PORT=3000
HOSTNAME=0.0.0.0

# --- gommo-backend ---
SERVER_PORT=8081
GOMMO_MULTI_TENANT_ENABLED=true
GOMMO_TENANT_HEADER_ENABLED=true
GOMMO_TENANT_PRODUCTION_BASE_DOMAIN=gommo.local
GOMMO_PLATFORM_ADMIN_PASSWORD=
CORS_ORIGINS=https://gommo.local,https://teste.gommo.local,https://admin.gommo.local,http://localhost:3000

# --- gommo-db (IntelliJ) ---
# Host: <LAB_LAN_HOST>  Port: 5432  DB: gommo  User: gommo  Password: (mesmo do Postgres do lab)
