# =============================================================================
# Lab LAN (Coolify + acesso remoto) — TEMPLATE (sem segredos)
# Domínios exemplo: admin.gesint.local / api.admin.gesint.local / gesint.local / api.gesint.local
# Copie para lab-gesint.local.env (gitignored) e preencha os valores reais.
# =============================================================================

# --- gesint-admin-frontend (Production) ---
AUTH_URL=https://admin.gesint.local
NEXTAUTH_URL=https://admin.gesint.local
NEXT_PUBLIC_ADMIN_API_URL=https://api.admin.gesint.local
NEXT_PUBLIC_HR_API_URL=https://api.gesint.local
# Lab only: TLS self-signed no fetch server-side do Auth.js
NODE_TLS_REJECT_UNAUTHORIZED=0
# Opcional: URL HTTP interna do admin-backend (UUID Coolify):8082
# ADMIN_API_INTERNAL_URL=http://<COOLIFY_ADMIN_BACKEND_UUID>:8082
PORT=3001
HOSTNAME=0.0.0.0
NEXTAUTH_SECRET=
AUTH_SECRET=

# --- gesint-admin-backend ---
ADMIN_SERVER_PORT=8082
ADMIN_CORS_ORIGINS=https://admin.gesint.local
GESINT_PLATFORM_ADMIN_PASSWORD=
JWT_SECRET=
GESINT_INTERNAL_EVENT_SECRET=
# URL INTERNA do gesint-backend (UUID do app no Coolify), NÃO a FQDN pública
GESINT_HR_BASE_URL=http://<COOLIFY_CLIENT_BACKEND_UUID>:8081

# --- gesint-frontend (Production) ---
AUTH_URL=https://gesint.local
NEXTAUTH_URL=https://gesint.local
NEXT_PUBLIC_API_URL=https://api.gesint.local
NEXT_PUBLIC_MULTI_TENANT_ENABLED=true
NEXT_PUBLIC_TENANT_PRODUCTION_BASE_DOMAIN=gesint.local
API_INTERNAL_URL=http://<COOLIFY_CLIENT_BACKEND_UUID>:8081
NODE_TLS_REJECT_UNAUTHORIZED=0
PORT=3000
HOSTNAME=0.0.0.0

# --- gesint-backend ---
SERVER_PORT=8081
GESINT_MULTI_TENANT_ENABLED=true
GESINT_TENANT_HEADER_ENABLED=true
GESINT_TENANT_PRODUCTION_BASE_DOMAIN=gesint.local
GESINT_PLATFORM_ADMIN_PASSWORD=
CORS_ORIGINS=https://gesint.local,https://teste.gesint.local,https://admin.gesint.local,http://localhost:3000

# --- gesint-db (IntelliJ) ---
# Host: <LAB_LAN_HOST>  Port: 5432  DB: gesint  User: gesint  Password: (mesmo do Postgres do lab)
