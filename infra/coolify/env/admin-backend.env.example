# --- PostgreSQL — mesmo banco do Client (host INTERNO do Coolify Database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gommo
DB_USER=gommo
DB_PASSWORD=

ADMIN_SERVER_PORT=8082

JWT_SECRET=
GOMMO_INTERNAL_EVENT_SECRET=

# URL INTERNA do gommo-backend (nao use a FQDN publica nem a URL do frontend)
# Local: http://localhost:8081 | Coolify: http://<uuid-ou-nome-do-gommo-backend>:8081
GOMMO_HR_BASE_URL=http://localhost:8081

# Origin exata do Admin frontend
ADMIN_CORS_ORIGINS=https://COLE-FQDN-GOMMO-ADMIN-FRONTEND

# Senha do sudo admGommo (bootstrap)
GOMMO_PLATFORM_ADMIN_PASSWORD=

# Respeita o limite de memoria do container (sugestao KVM 2: 640M)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Copia local pronta: gommo-admin-backend/.env (e .env.example)
# Lab LAN pronto: infra/coolify/env/lab-gommo.local.env
