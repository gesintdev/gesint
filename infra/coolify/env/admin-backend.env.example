# --- PostgreSQL — mesmo banco do Client (host INTERNO do Coolify Database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesint
DB_USER=gesint
DB_PASSWORD=

ADMIN_SERVER_PORT=8082

JWT_SECRET=
GESINT_INTERNAL_EVENT_SECRET=

# URL INTERNA do gesint-backend (nao use a FQDN publica nem a URL do frontend)
# Local: http://localhost:8081 | Coolify: http://<uuid-ou-nome-do-gesint-backend>:8081
GESINT_HR_BASE_URL=http://localhost:8081

# Origin exata do Admin frontend
ADMIN_CORS_ORIGINS=https://COLE-FQDN-GESINT-ADMIN-FRONTEND

# Senha do sudo admGesint (bootstrap)
GESINT_PLATFORM_ADMIN_PASSWORD=

# Respeita o limite de memoria do container (sugestao KVM 2: 640M)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Copia local pronta: gesint-admin-backend/.env (e .env.example)
# Lab LAN (template): infra/coolify/env/lab-gesint.local.env.example
