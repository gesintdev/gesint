# Runtime (Coolify Environment)
PORT=3001
HOSTNAME=0.0.0.0
# OBRIGATÓRIO: mesmo host do browser (não use sslip.io gerado pelo Coolify)
NEXTAUTH_URL=https://COLE-FQDN-GOMMO-ADMIN-FRONTEND
AUTH_URL=https://COLE-FQDN-GOMMO-ADMIN-FRONTEND
NEXTAUTH_SECRET=
AUTH_SECRET=

# Lab com cert self-signed (*.local): necessário para Auth.js chamar a API no server
NODE_TLS_REJECT_UNAUTHORIZED=0

# Opcional: HTTP interno do admin-backend (evita Traefik/TLS no authorize)
# ADMIN_API_INTERNAL_URL=http://<uuid-coolify-admin-backend>:8082

# Build-time (Coolify Build Arguments) — exige rebuild ao mudar
NEXT_PUBLIC_ADMIN_API_URL=https://COLE-FQDN-GOMMO-ADMIN-BACKEND
NEXT_PUBLIC_HR_API_URL=https://COLE-FQDN-GOMMO-BACKEND

# Copia local pronta: gommo-admin-frontend/.env (localhost)
# Lab LAN pronto: infra/coolify/env/lab-gommo.local.env
