# Copie para .env — nunca commite .env
# Formato alinhado ao Coolify (Application gesint-admin-backend).
# Ver tambem: infra/coolify/env/admin-backend.env.example
#
# Nao defina SPRING_PROFILES_ACTIVE neste arquivo (quebra o perfil dev).
# Prod nativo: mvn -q spring-boot:run -Dspring-boot.run.profiles=prod

ADMIN_SERVER_PORT=8082

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gesint
DB_USER=gesint
DB_PASSWORD=gesint_dev

JWT_SECRET=altere-para-minimo-32-caracteres-aleatorios
GESINT_INTERNAL_EVENT_SECRET=altere-este-segredo-compartilhado

GESINT_HR_BASE_URL=http://localhost:8081
ADMIN_CORS_ORIGINS=http://localhost:3001
TENANT_DB_FALLBACK_PASSWORD=gesint_dev

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
