# Copie para .env — nunca commite .env
# Formato alinhado ao Coolify (Application gommo-admin-frontend).
# Ver tambem: infra/coolify/env/admin-frontend.env.example
#
# Next.js: .env.local (se existir) sobrescreve este arquivo.
# AUTH_URL e NEXTAUTH_URL devem ser :3001 (nao use :3000 do Client).

PORT=3001
HOSTNAME=0.0.0.0

NEXTAUTH_URL=http://localhost:3001
AUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=altere-para-minimo-32-caracteres-aleatorios
AUTH_SECRET=altere-para-minimo-32-caracteres-aleatorios

NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8082
NEXT_PUBLIC_HR_API_URL=http://localhost:8081
